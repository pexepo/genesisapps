# --- Discord ---
# Токен бота из https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your-discord-bot-token-here

# ID форум-канала, куда создавать посты (вкл. режим разработчика в Discord ->
# ПКМ по форум-каналу -> "Скопировать ID канала")
FORUM_CHANNEL_ID=000000000000000000

# --- Review-флоу ---
# Роль, которой РАЗРЕШЕНО жать Accept/Decline и выбирать роль (ПКМ по роли ->
# Копировать ID роли). Обязательное поле.
REVIEWER_ROLE_ID=000000000000000000

# Пинговать ли роль судей в новом посте-заявке (1 = да, 0 = нет).
PING_REVIEWER=1

# Role assigned immediately after a verified website application is submitted.
# Leave empty to disable it. The bot role must be above this role.
APPLICANT_ROLE_ID=

# 4 кнопки выбора роли в приватном сообщении после Accept.
# Для каждой: _ID = ID выдаваемой роли, _NAME = подпись на кнопке.
# Можно заполнить меньше четырёх — пустые пропускаются.
ROLE_CHOICE_1_ID=000000000000000000
ROLE_CHOICE_1_NAME=✧
ROLE_CHOICE_2_ID=000000000000000000
ROLE_CHOICE_2_NAME=✧✧
ROLE_CHOICE_3_ID=000000000000000000
ROLE_CHOICE_3_NAME=✧✧✧
ROLE_CHOICE_4_ID=000000000000000000
ROLE_CHOICE_4_NAME=trial

# Extra role assigned together with ROLE_CHOICE_1, 2 or 3.
# ROLE_CHOICE_4 only assigns its own role.
CORE_MEMBER_ROLE_ID=000000000000000000

# Теги статуса в форум-канале (необязательно). Если указать ID тегов "Accepted"
# и "Declined", бот будет вешать их на ветку при решении. ID тега берётся из
# настроек форум-канала (см. README, раздел "Теги статуса").
ACCEPTED_TAG_ID=000000000000000000
DECLINED_TAG_ID=000000000000000000

# --- HTTP-сервер, который принимает заявки от Google Apps Script ---
# Общий секрет: тот же самый пропиши в apps_script.gs. Защищает эндпоинт от чужих запросов.
SHARED_SECRET=change-me-to-a-long-random-string

# Адрес и порт, на котором бот слушает входящие POST-запросы.
# 0.0.0.0 = слушать на всех интерфейсах. Порт можно любой свободный.
HOST=0.0.0.0
PORT=8080

# --- Необязательное ---
# Список ID тегов форума через запятую, которые автоматически вешать на КАЖДЫЙ новый пост.
DEFAULT_TAG_IDS=

# Файл состояния заявок (дедуп + работа кнопок после рестарта). Можно не менять.
STATE_FILE=submissions.json

# --- Сайт-заявка (эндпоинт /apply, см. README "Сайт-заявка") ---
# Антиспам: не более APPLY_RATE_MAX заявок с одного IP за APPLY_RATE_WINDOW секунд.
APPLY_RATE_MAX=5
APPLY_RATE_WINDOW=600
# Заголовок поста для заявок, пришедших с сайта.
APPLY_FORM_TITLE=Genesis application

# Интервал между заявками с одного подтверждённого Discord-аккаунта или IP
# в секундах. 86400 = 24 часа.
APPLICATION_COOLDOWN=86400

# Ставь 1 только за доверенным reverse proxy (Cloudflare/Caddy/nginx), который
# сам перезаписывает X-Forwarded-For. При прямом запуске и для локального теста — 0.
TRUST_PROXY=0

# --- Вход на сайт через Discord OAuth2 ---
# OAuth подтверждает Discord ID заявителя: пользователь нажимает «Войти через
# Discord», разрешает доступ только к базовому профилю (scope: identify), после
# чего возвращается на сайт. Пароль Discord бот не получает и не хранит.
#
# Настройка:
# 1. Открой https://discord.com/developers/applications и выбери ТО ЖЕ приложение,
#    в котором создан бот.
# 2. В разделе OAuth2 -> General скопируй Client ID в DISCORD_CLIENT_ID.
# 3. Там же создай/сбрось Client Secret и сразу скопируй его в
#    DISCORD_CLIENT_SECRET. Это секрет: не отправляй его другим и не коммить .env.
#    Client Secret — НЕ токен бота; это два разных значения.
# 4. В OAuth2 -> General -> Redirects добавь callback сайта. Адрес должен совпадать
#    с DISCORD_REDIRECT_URI полностью, включая http/https, домен, порт и путь.
#
# Для локального запуска добавь Redirect:
#   http://localhost:8080/auth/callback
# и укажи такое же значение в DISCORD_REDIRECT_URI.
#
# Для сайта с доменом добавь Redirect, например:
#   https://apply.example.com/auth/callback
# и замени apply.example.com на реальный домен.
#
# Важно:
# - заполни все три DISCORD_* значения одновременно; при частичной настройке бот
#   специально не запустится, чтобы не работать с повреждённой конфигурацией;
# - после изменения Redirect нажми Save Changes в Discord Developer Portal;
# - OAuth работает через HTTP-сервер bot.py. Обычный `python3 -m http.server`
#   показывает интерфейс, но не обрабатывает вход и callback;
# - для production используй HTTPS.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback

# Отдельный случайный ключ для подписи cookie-сессии и хеширования IP. Не используй
# здесь DISCORD_CLIENT_SECRET или DISCORD_TOKEN. Сгенерировать безопасное значение:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-session-secret

# Срок жизни авторизации в секундах. 604800 = 7 дней.
SESSION_MAX_AGE=604800

# --- Optional outbound proxy for Discord ---
# HTTP or HTTPS proxy outside a restricted region. This is NOT Cloudflare/Caddy.
# Example: http://proxy.example.net:3128
OUTBOUND_PROXY=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Кастомизация embed (всё необязательно, см. README "Кастом embed") ---
# Цвет полоски слева. HEX: #5865F2 / 5865F2 / 0x5865F2. Пусто = blurple.
EMBED_COLOR=#E5E5E5
# Заголовок поста. Пусто = название формы. Можно подставлять {form_title} и {responder}.
EMBED_TITLE=new application!
# Текст футера. Пусто = убрать футер. Поддерживает {form_title} и {responder}.
EMBED_FOOTER=app from {responder}!
# URL картинок (https://...). Пусто = не показывать.
EMBED_FOOTER_ICON=
EMBED_THUMBNAIL=
EMBED_IMAGE=https://files.catbox.moe/jp1jek.gif
EMBED_AUTHOR_ICON=
# Показывать отправителя как автора эмбеда и время заявки: 1 = да, 0 = нет.
EMBED_SHOW_AUTHOR=1
EMBED_SHOW_TIMESTAMP=1
